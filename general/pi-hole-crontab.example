# Redacted template. Substitute the placeholders by hand. cron does not expand
# a shell variable here, so MAILTO must hold a literal address.
MAILTO="<your-email>"

# cron mails any output of a job to MAILTO. Do not also send stderr to a log
# file. The mail then arrives empty, and the errors stay on the host.

30 2 * * 0 /usr/local/bin/pihole -up --unattended

# The noninteractive settings prevent a block on a configuration prompt.
0 3 * * 0 DEBIAN_FRONTEND=noninteractive apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get -y -o Dpkg::Options::=--force-confold upgrade && apt-get autoremove -y

30 3 * * * /usr/sbin/log2ram write

35 3 * * * /usr/local/bin/pihole restartdns >/dev/null 2>&1

0 4 * * 0 /sbin/reboot
