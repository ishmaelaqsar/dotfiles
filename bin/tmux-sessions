#!/usr/bin/env bash
# tmux-sessions: pick, create, or kill sessions from an fzf list. It runs
# inside a tmux display-popup (session menu s, or M-s with no leader).
#
# Enter on a session switches this client to it. Enter on a query that
# matches nothing creates a detached session by that name and switches to it.
# C-x kills the highlighted session and reloads the list; when that was the
# session this client is on, detach-on-destroy no-detached moves the client
# to a detached session and the popup goes with it.
#
# Session names pass through `-t "=$name"`, so they match exactly and never as
# a prefix or glob. __tmux_goto in .aliases follows the same rule. fzf expands
# {1} to a single-quoted word, and zsh reads a bare leading = as an equals
# expansion. So the preview and kill commands assign the name to a variable
# rather than write `-t ={1}`.

set -u

if ! command -v fzf >/dev/null 2>&1; then
    # The popup closes when this exits, so the message names the package, and
    # the sleep keeps it on screen.
    repo="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
    hint="$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1] + "/lib"); import pkgconf; print(pkgconf.install_hint("fzf"))' "$repo" 2>/dev/null)"
    echo "tmux-sessions needs fzf. ${hint:-Install fzf with your package manager.}"
    sleep 3
    exit 1
fi

if [ -z "${TMUX:-}" ]; then
    echo 'tmux-sessions only works inside tmux'
    sleep 2
    exit 1
fi

# Exported so the reload() child shell sees it too. The separator is a tab.
export TS_FMT='#{session_name}	#{session_windows}w#{?session_attached, (attached),}'

out=$(tmux list-sessions -F "$TS_FMT" | fzf \
    --print-query \
    --prompt='session > ' \
    --header='enter picks or creates, C-x kills' \
    --delimiter='	' \
    --nth=1 \
    --preview='n={1}; tmux list-windows -t "=$n"' \
    --preview-window=right,55% \
    --bind='ctrl-x:execute-silent(n={1}; tmux kill-session -t "=$n")+reload(tmux list-sessions -F "$TS_FMT")')
status=$?

query=$(printf '%s\n' "$out" | sed -n 1p)
match=$(printf '%s\n' "$out" | sed -n 2p)

case $status in
    0)  # Enter on a session: switch this client to it.
        tmux switch-client -t "=${match%%$'\t'*}"
        ;;
    1)  # Enter with no match: the query becomes a new detached session.
        [ -n "$query" ] || exit 0
        if ! err=$(tmux new-session -d -s "$query" 2>&1); then
            echo "$err"      # tmux refuses a name with . or : in it. Show why.
            sleep 2
            exit 1
        fi
        tmux switch-client -t "=$query"
        ;;
    *)  exit 0 ;;            # Escape / C-g
esac
