#!/usr/bin/env python3
"""
manage-secrets — keep the secrets in dotfiles/.secrets encrypted.

Every entry in the file has the form KEY=${enc:BASE64}. The base64 holds a GPG
message for the recipient's key, so the file is safe to commit. GPG asks the
YubiKey to decrypt it.

The pre-commit hook runs `verify`, which fails the commit when a cleartext
value reaches the file.
"""

import argparse
import base64
import os
import re
import shlex
import shutil
import subprocess
import sys

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
SECRETS_FILE = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "dotfiles", ".secrets"
)
# Pattern: KEY=${enc:BASE64_BLOB}
REGEX_ENTRY = re.compile(r"^\s*([A-Z0-9_]+)=\$\{enc:(.+)\}\s*$")
# Pattern: KEY=VALUE (Unencrypted)
REGEX_UNENCRYPTED = re.compile(r"^\s*([A-Z0-9_]+)=(?!\$\{enc:)(.+)\s*$")


def get_gpg_recipient():
    """Return git user.email as the GPG recipient, or exit."""
    try:
        email = subprocess.check_output(
            ["git", "config", "user.email"], text=True
        ).strip()
        if email:
            return email
    except Exception:
        pass

    print(
        "Error: Could not detect GPG recipient (git user.email). Pass --recipient manually.",
        file=sys.stderr,
    )
    sys.exit(1)


def gpg_encrypt(cleartext, recipient):
    """
    Encrypts data using GPG (and YubiKey) -> returns Base64 string.
    """
    try:
        # --no-armor because gpg.conf sets `armor`, and base64 of ASCII armour
        # is about 1.8 times the size of base64 of the binary. gpg reads either
        # form back, so an entry written before this stays valid.
        proc = subprocess.Popen(
            ["gpg", "--encrypt", "--no-armor", "--recipient", recipient,
             "--trust-model", "always"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        encrypted_data, err = proc.communicate(input=cleartext.encode("utf-8"))

        if proc.returncode != 0:
            print(f"GPG Encryption failed: {err.decode()}", file=sys.stderr)
            sys.exit(1)

        return base64.b64encode(encrypted_data).decode("utf-8")
    except Exception as e:
        print(f"Error during encryption: {e}", file=sys.stderr)
        sys.exit(1)


def gpg_decrypt(b64_data, fatal=True):
    """Decrypt one base64 blob, and return the cleartext.

    With fatal set, a failure ends the process. cmd_run passes fatal=False, so
    that one secret it cannot read does not stop the others.
    """
    try:
        encrypted_bytes = base64.b64decode(b64_data)

        proc = subprocess.Popen(
            ["gpg", "--decrypt", "--quiet"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        decrypted_data, err = proc.communicate(input=encrypted_bytes)

        if proc.returncode != 0:
            # No stderr here: a cancelled PIN prompt would print a GPG trace
            raise Exception("GPG Decryption failed (Check PIN or YubiKey presence)")

        return decrypted_data.decode("utf-8").strip()
    except Exception as e:
        if not fatal:
            raise
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


def load_secrets():
    """Reads the secrets file and returns lines."""
    if not os.path.exists(SECRETS_FILE):
        return []
    with open(SECRETS_FILE, "r") as f:
        return f.readlines()


def cmd_encrypt(args):
    """Encrypt one value into the file, and print the export line."""
    key = args.key.upper()
 
    if args.value:
        value = args.value
    else:
        if sys.stdin.isatty():
            print(f"# Enter value for {key} (Press Ctrl+D when finished):", file=sys.stderr)
        value = sys.stdin.read().strip()

    recipient = args.recipient or get_gpg_recipient()

    print(f"# Encrypting {key} for {recipient}...", file=sys.stderr)

    b64_encrypted = gpg_encrypt(value, recipient)
    new_line = f"{key}=${{enc:{b64_encrypted}}}\n"

    lines = load_secrets()
    updated_lines = []
    found = False

    for line in lines:
        # Update existing key if found
        if line.strip().startswith(f"{key}="):
            updated_lines.append(new_line)
            found = True
        else:
            updated_lines.append(line)

    if not found:
        if updated_lines and not updated_lines[-1].endswith("\n"):
            updated_lines[-1] += "\n"
        updated_lines.append(new_line)

    with open(SECRETS_FILE, "w") as f:
        f.writelines(updated_lines)

    os.chmod(SECRETS_FILE, 0o600)

    print(f"export {key}={shlex.quote(value)}")
    print(f"# stored in {SECRETS_FILE}", file=sys.stderr)


def cmd_decrypt(args):
    """Print an export line for every secret, or for the named ones."""
    lines = load_secrets()
    # Convert requested keys to uppercase for matching
    target_keys = set(k.upper() for k in args.keys) if args.keys else None

    print("# Decrypting secrets...", file=sys.stderr)

    for line in lines:
        match = REGEX_ENTRY.match(line)
        if match:
            key = match.group(1)

            # If target_keys is provided, skip keys not in the list
            if target_keys is not None and key not in target_keys:
                continue

            b64_blob = match.group(2)
            cleartext = gpg_decrypt(b64_blob)
            print(f"export {key}={shlex.quote(cleartext)}")


def cmd_verify(args):
    """Fail when any entry is cleartext. The pre-commit hook runs this."""
    lines = load_secrets()
    has_error = False

    for i, line in enumerate(lines):
        line = line.strip()
        if not line or line.startswith("#"):
            continue

        # If it looks like a variable assignment but NOT an encrypted one
        if REGEX_UNENCRYPTED.match(line):
            print(
                f"[FAIL] Line {i+1}: Unencrypted secret found: {line.split('=')[0]}",
                file=sys.stderr,
            )
            has_error = True

        # If it is encrypted, verify base64 integrity (optional, but good practice)
        match = REGEX_ENTRY.match(line)
        if match:
            try:
                base64.b64decode(match.group(2), validate=True)
            except Exception:
                print(
                    f"[FAIL] Line {i+1}: Malformed Base64 in secret: {match.group(1)}",
                    file=sys.stderr,
                )
                has_error = True
            continue

        # Neither a comment nor an encrypted entry. Report the line number
        # only: the content could be the secret itself.
        print(f"[FAIL] Line {i+1}: not an encrypted entry.", file=sys.stderr)
        has_error = True

    if has_error:
        print("Verification failed.", file=sys.stderr)
        sys.exit(1)
    else:
        print("Secrets verified encrypted.", file=sys.stderr)


def cmd_run(args):
    """Decrypt every secret into the environment, then exec the command."""
    # 1. Load and Decrypt all secrets
    lines = load_secrets()
    env_updates = {}

    for line in lines:
        match = REGEX_ENTRY.match(line)
        if match:
            key = match.group(1)
            b64_blob = match.group(2)
            try:
                # Decrypt and store in a dict
                cleartext = gpg_decrypt(b64_blob, fatal=False)
                env_updates[key] = cleartext
            except Exception:
                print(f"Warning: Could not decrypt {key}, skipping.", file=sys.stderr)

    # 2. Merge with current environment
    # Copy the current environment, so the child keeps PATH, USER and the rest.
    new_env = os.environ.copy()
    new_env.update(env_updates)

    # 3. Execute the command
    if not args.command_args:
        print("Error: No command provided to run.", file=sys.stderr)
        sys.exit(1)

    # argparse keeps the `--` separator in a REMAINDER, and it is not the
    # command to run.
    command = args.command_args
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        print("Error: No command provided to run.", file=sys.stderr)
        sys.exit(1)

    try:
        # Replace the current python process with the new command
        # This preserves PID and handles signals correctly
        os.execvpe(command[0], command, new_env)
    except FileNotFoundError:
        print(f"Error: Command not found: {command[0]}", file=sys.stderr)
        sys.exit(1)


def secret_keys():
    """Return the name of every encrypted secret, and decrypt nothing."""
    keys = []
    for line in load_secrets():
        match = REGEX_ENTRY.match(line)
        if match:
            keys.append(match.group(1))
    return keys


def cmd_list(_args):
    """Print the name of every secret.

    Browsing the keys must never touch the YubiKey, so this reads the names out
    of the file and decrypts nothing.
    """
    keys = secret_keys()
    if not keys:
        print(f"No secret is stored in {SECRETS_FILE}.", file=sys.stderr)
        return 1
    for key in keys:
        print(key)
    return 0


def pick_secret():
    """Return a secret name chosen with fzf, or None.

    There is deliberately no preview: a preview would decrypt the value to
    render it, which is the one thing browsing must not do. Without a terminal,
    or without fzf, print the names and stop, so a script gets a list.
    """
    keys = secret_keys()
    if not keys:
        print(f"No secret is stored in {SECRETS_FILE}.", file=sys.stderr)
        return None

    if not sys.stdin.isatty() or shutil.which("fzf") is None:
        reason = "fzf is not installed" if sys.stdin.isatty() else "there is no terminal"
        print(f"Cannot ask which secret: {reason}.", file=sys.stderr)
        print("Name one. These exist:", file=sys.stderr)
        for key in keys:
            print(f"  {key}", file=sys.stderr)
        return None

    picked = subprocess.run(
        ["fzf", "--height", "40%", "--reverse", "--prompt", "secret > "],
        input="\n".join(keys),
        capture_output=True,
        text=True,
    )
    return picked.stdout.strip() or None


def cmd_get(args):
    """Print one decrypted value, with no export syntax and no newline."""
    if not args.key:
        key = pick_secret()
        if not key:
            return 1
        args.key = key
    target_key = args.key.upper()
    lines = load_secrets()

    for line in lines:
        match = REGEX_ENTRY.match(line)
        if match:
            key = match.group(1)
            if key == target_key:
                b64_blob = match.group(2)
                print(gpg_decrypt(b64_blob), end="")  # end='' prevents trailing newline
                return

    print(f"Error: Secret '{target_key}' not found.", file=sys.stderr)
    sys.exit(1)


EXAMPLES = """
Examples:
  manage-secrets encrypt OPENAI_API_KEY "sk-..."   # add or replace a secret
  echo "sk-..." | manage-secrets encrypt OPENAI_API_KEY
  manage-secrets list                              # every name, no decryption
  manage-secrets get OPENAI_API_KEY                # one value, to stdout
  manage-secrets get                               # pick a name, then decrypt
  manage-secrets decrypt                           # every value, as KEY=VALUE
  manage-secrets run -- ./deploy.sh                # run with the secrets loaded
  manage-secrets verify                            # the pre-commit hook runs this

Exit codes: 0 success, 1 a secret is cleartext, missing, or GPG failed.
Every command that decrypts asks the YubiKey for the PIN.
"""


def main():
    parser = argparse.ArgumentParser(
        description="Keep the secrets in dotfiles/.secrets encrypted with GPG.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", metavar="<command>")

    # Encrypt Command
    p_enc = subparsers.add_parser("encrypt", help="Add or replace one secret")
    p_enc.add_argument("key", help="The environment variable name")
    p_enc.add_argument(
        "value", nargs="?", help="The value. Omit it to read stdin instead."
    )
    p_enc.add_argument(
        "--recipient", help="The GPG recipient. It defaults to git user.email."
    )

    # Decrypt Command
    p_dec = subparsers.add_parser("decrypt", help="Print every secret as KEY=VALUE")
    p_dec.add_argument("keys", nargs="*", help="Print only these keys")

    # Verify Command
    subparsers.add_parser("verify", help="Prove that no secret is cleartext")

    # Run Command
    p_run = subparsers.add_parser("run", help="Run a command with the secrets loaded")
    p_run.add_argument(
        "command_args", nargs=argparse.REMAINDER, help="The command, after --"
    )

    # Get Command
    p_get = subparsers.add_parser("get", help="Print the value of one secret")
    p_get.add_argument(
        "key", nargs="?", help="The name. Omit it to pick one instead."
    )

    # List Command
    subparsers.add_parser("list", help="Print every secret name, and decrypt nothing")

    args = parser.parse_args()

    # No command: print the help, and exit 0. An agent or a new reader then
    # sees the whole interface without a failed run.
    if args.command is None:
        parser.print_help()
        return

    if args.command == "encrypt":
        cmd_encrypt(args)
    elif args.command == "decrypt":
        cmd_decrypt(args)
    elif args.command == "verify":
        cmd_verify(args)
    elif args.command == "run":
        cmd_run(args)
    elif args.command == "get":
        # cmd_get returns 1 when it cannot ask which secret, and None when it
        # printed one, so the exit code has to carry that through.
        sys.exit(cmd_get(args) or 0)
    elif args.command == "list":
        sys.exit(cmd_list(args))


if __name__ == "__main__":
    main()

