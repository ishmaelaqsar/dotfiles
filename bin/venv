#!/usr/bin/env python3
"""
venv — create and inspect Python virtual environments.

The environment goes in the project root, which is the nearest parent directory
with a .git. `init` uses uv when uv is on PATH, because it is much faster, and
falls back to `python3 -m venv`.

A script cannot change the shell of its caller, so `start` and `stop` print the
command to run. They do not activate anything themselves.
"""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

EXAMPLES = """
Examples:
  venv init                     # create .venv in the project root
  venv init -p python3.12       # create it with one interpreter
  venv init env --seed          # name the directory, and pass uv an option
  venv start                    # print the source command to activate it
  venv path                     # print the path, for a script to read
  venv list ~/workspace         # every environment under a directory

With no command, venv prints the path of the active or detected environment.

Exit codes: 0 success, 1 no environment exists or the creation failed.
"""


# ------------------------------------------------------------
# Utility helpers
# ------------------------------------------------------------
def project_root() -> Path:
    """Return the nearest parent directory with a .git, else the current one."""
    cwd = Path.cwd()
    for parent in [cwd] + list(cwd.parents):
        if (parent / ".git").exists():
            return parent
    return cwd


def venv_path(venv_dir: str = ".venv") -> Path:
    """Return the environment directory under the project root."""
    return project_root() / venv_dir


def run(cmd, check=True, **kwargs):
    """Print a command, then run it."""
    print(f"→ {' '.join(cmd)}")
    subprocess.run(cmd, check=check, **kwargs)


# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------
def cmd_init(args):
    root = project_root()
    target = root / args.dir
    python_cmd = args.python or "python3"

    # uv is much faster than the stdlib module, so prefer it when it is present.
    if shutil.which("uv") is not None:
        print(f"uv creates the environment at {target}. Python: {python_cmd}")
        cmd = ["uv", "venv", str(target), "--python", python_cmd] + args.venv_options
    else:
        print(f"python creates the environment at {target}. Python: {python_cmd}")
        cmd = [python_cmd, "-m", "venv", str(target)] + args.venv_options

    try:
        run(cmd)
        print("The environment is ready.")
    except subprocess.CalledProcessError:
        print("Error: Cannot create the environment.", file=sys.stderr)
        sys.exit(1)


def cmd_start(args):
    """Print the command that activates the environment."""
    target = venv_path(args.dir)
    activate_script = target / "bin" / "activate"
    if activate_script.exists():
        print(f"To activate the environment, run:\n\n  source {activate_script}\n")
    else:
        print(f"No environment at {target}.")
        print("Run 'venv init' first.")
        sys.exit(1)


def cmd_stop(_args):
    """Print the active environment, and the command that leaves it."""
    venv = os.environ.get("VIRTUAL_ENV")
    if venv:
        print(f"The active environment is {venv}.")
        print("To leave it, run:\n\n  deactivate\n")
    else:
        print("No environment is active.")


def cmd_restart(args):
    """Print the two steps, because a script cannot change the shell."""
    print("Leave the environment, then activate it again:")
    cmd_stop(args)
    cmd_start(args)


def cmd_path(_args):
    venv = os.environ.get("VIRTUAL_ENV")
    if venv:
        print(venv)
    else:
        target = venv_path()
        if target.exists():
            print(target)
        else:
            print("No environment found.", file=sys.stderr)
            sys.exit(1)


def cmd_list(args):
    search_dir = (
        Path(args.search_dir).expanduser()
        if args.search_dir
        else Path(os.environ.get("WORKSPACE", Path.home()))
    )
    print(f"Environments under {search_dir}:")
    print("-----------------------------------------------------")

    found = False
    for bin_dir in search_dir.rglob(".venv/bin"):
        venv_dir = bin_dir.parent
        py = bin_dir / "python"
        pyver = (
            subprocess.run(
                [str(py), "-V"], capture_output=True, text=True
            ).stdout.strip()
            if py.exists()
            else "Unknown"
        )
        marker = "(active)" if os.environ.get("VIRTUAL_ENV") == str(venv_dir) else ""
        workspace = venv_dir.parent.name
        print(f"{workspace:20} ->  {venv_dir}  [{pyver}] {marker}")
        found = True

    if not found:
        print("No environment found.")


# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="venv",
        description="Create and inspect Python virtual environments.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")

    p_init = sub.add_parser("init", help="Create an environment")
    p_init.add_argument(
        "-p", "--python", help="The interpreter to use. It defaults to python3."
    )
    p_init.add_argument(
        "dir",
        nargs="?",
        default=".venv",
        help="The directory, under the project root. It defaults to .venv.",
    )
    p_init.add_argument(
        "venv_options",
        nargs=argparse.REMAINDER,
        help="Options to pass on to uv or to python -m venv",
    )

    p_start = sub.add_parser("start", help="Print the command that activates it")
    p_start.add_argument("dir", nargs="?", default=".venv", help="The directory")

    sub.add_parser("stop", help="Print the active environment, and how to leave it")

    p_restart = sub.add_parser("restart", help="Print the stop and the start steps")
    p_restart.add_argument("dir", nargs="?", default=".venv", help="The directory")

    sub.add_parser("path", help="Print the path of the active or detected environment")

    p_list = sub.add_parser("list", help="List the environments under a directory")
    p_list.add_argument(
        "search_dir",
        nargs="?",
        default=None,
        help="Where to search. It defaults to $WORKSPACE, then $HOME.",
    )

    sub.add_parser("help", help="Print this text")
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.command in (None, "path"):
        # No command prints the path, so a script can read it.
        cmd_path(args)
        return
    if args.command == "help":
        parser.print_help()
        return

    {
        "init": cmd_init,
        "start": cmd_start,
        "stop": cmd_stop,
        "restart": cmd_restart,
        "list": cmd_list,
    }[args.command](args)


if __name__ == "__main__":
    main()
