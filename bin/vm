#!/usr/bin/env python3
"""
vm — manage one QEMU virtual machine, on Linux or on macOS.

The script wraps virsh and virt-install, and picks the defaults of the host:
KVM with Spice on Linux, HVF with VNC on macOS. Apple Silicon gets its own
machine type and firmware.

Set VM_NAME, and every command then acts on that machine without a flag.
"""

import os
import sys
import subprocess
import argparse
import shutil
import platform
import time

EXAMPLES = """
Environment:
  VM_NAME              The machine to act on. -n overrides it.
  VM_USER              The user for ssh, deploy and setup. -u overrides it.
  LIBVIRT_DEFAULT_URI  The libvirt URI. It defaults to qemu:///system on Linux,
                       and to qemu:///session on macOS.

Examples:
  vm list                        # every machine the daemon knows
  vm -n debian12 start           # start one machine
  vm status                      # the state and the address of $VM_NAME
  vm create --ram 4096 --cpu 4   # a new Debian 12 machine
  vm create --iso ~/iso/alpine.iso --variant alpine3.19
  vm ssh                         # open a session
  vm ssh uname -a                # run one command, then exit
  vm deploy ./setup.sh           # run a local script, with the user and the
                                 # address as its two arguments
  vm --dry-run delete            # print the commands, and change nothing

With no command, vm prints the status of $VM_NAME. It prints this text when
VM_NAME is not set.

Exit codes: 0 success, 1 a command failed, a name is missing, or a tool is
absent.
"""

# ------------------------------------------------------------
# Backend configuration: the per-OS mapping
# ------------------------------------------------------------


class VMBackend:
    def __init__(self):
        self.os_type = platform.system()
        self.arch = platform.machine()

    def get_connection_uri(self):
        """Return the libvirt URI for this host."""
        # Linux normally runs libvirt system-wide.
        if self.os_type == "Linux":
            return os.environ.get("LIBVIRT_DEFAULT_URI", "qemu:///system")

        # The Homebrew build on macOS normally runs in session mode.
        if self.os_type == "Darwin":
            return os.environ.get("LIBVIRT_DEFAULT_URI", "qemu:///session")

        return "qemu:///system"

    def get_install_args(self):
        """Return the virt-install arguments for this host."""

        # --- LINUX DEFAULTS (KVM) ---
        if self.os_type == "Linux":
            args = [
                "--connect",
                self.get_connection_uri(),
                "--accelerate",
                "--network",
                "network=default",
                "--graphics",
                "spice",
                "--video",
                "qxl",
                "--channel",
                "spicevmc",
            ]

            # Extra settings for an ARM host
            if self.arch in ("aarch64", "arm64"):
                args += [
                    "--arch",
                    "aarch64",
                    "--machine",
                    "virt",
                    "--boot",
                    "uefi",
                ]

            return args

        # --- MACOS DEFAULTS (HVF / Apple Silicon) ---
        if self.os_type == "Darwin":
            args = ["--connect", self.get_connection_uri()]

            # Apple Silicon settings
            if self.arch == "arm64":
                args += [
                    "--arch",
                    "aarch64",
                    "--machine",
                    "virt",
                    "--boot",
                    "uefi",  # Essential for ARM64
                ]

            # The macOS builds support Spice poorly, so use VNC with
            # virtio-gpu. It is more stable there.
            args += [
                "--graphics",
                "vnc",
                "--video",
                "virtio",
                "--network",
                "network=default,model=virtio",
            ]
            return args

        return []

    def get_virsh_cmd(self, args):
        """Return a virsh command with the correct URI."""
        return ["virsh", "--connect", self.get_connection_uri()] + args

    def get_package_manager_commands(self):
        """Return the commands that install the guest agent, per package manager."""
        # Each entry detects one package manager. The list covers the common
        # distros only.
        return [
            # Debian/Ubuntu (apt)
            {
                "detect": "command -v apt >/dev/null 2>&1",
                "install": [
                    "sudo apt update",
                    "sudo apt install -y qemu-guest-agent",
                    "sudo systemctl enable --now qemu-guest-agent",
                ],
            },
            # RHEL/Fedora/CentOS (dnf/yum)
            {
                "detect": "command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1",
                "install": [
                    "sudo bash -c 'command -v dnf >/dev/null && dnf install -y qemu-guest-agent || yum install -y qemu-guest-agent'",
                    "sudo systemctl enable --now qemu-guest-agent",
                ],
            },
            # Arch Linux (pacman)
            {
                "detect": "command -v pacman >/dev/null 2>&1",
                "install": [
                    "sudo pacman -Sy --noconfirm qemu-guest-agent",
                    "sudo systemctl enable --now qemu-guest-agent",
                ],
            },
            # Alpine Linux (apk)
            {
                "detect": "command -v apk >/dev/null 2>&1",
                "install": [
                    "sudo apk update",
                    "sudo apk add qemu-guest-agent",
                    "sudo rc-update add qemu-guest-agent default",
                    "sudo rc-service qemu-guest-agent start",
                ],
            },
        ]


# The backend for this host
BACKEND = VMBackend()

# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------


def run(cmd, check=True, capture=False, dry_run=False):
    """Print a command, then run it. Return its output when capture is true."""
    if dry_run:
        print(f"🛑 [DRY-RUN] {' '.join(cmd)}")
        return ""

    if not capture:
        print(f"→ {' '.join(cmd)}")
    try:
        result = subprocess.run(cmd, check=check, capture_output=capture, text=True)
        return result.stdout.strip() if capture else None
    except subprocess.CalledProcessError as e:
        if check:
            print(f"❌ Command failed: {' '.join(cmd)}", file=sys.stderr)
            if capture and e.stderr:
                print(e.stderr, file=sys.stderr)
            sys.exit(1)
        raise e


def check_libvirt_running():
    """Return true when the libvirt daemon answers."""
    try:
        result = subprocess.run(
            BACKEND.get_virsh_cmd(["version"]),
            capture_output=True,
            text=True,
            timeout=10,
        )
        return result.returncode == 0
    except (
        subprocess.TimeoutExpired,
        subprocess.CalledProcessError,
        FileNotFoundError,
    ):
        return False


def get_arg_or_env(args, key, env_var):
    """Return the argument, else the environment variable."""
    val = getattr(args, key, None)
    if val:
        return val
    return os.environ.get(env_var)


def require_vm_name(args):
    name = get_arg_or_env(args, "name", "VM_NAME")
    if not name:
        print("❌ Error: No VM name specified.", file=sys.stderr)
        print("  Use -n <name> or set VM_NAME environment variable.", file=sys.stderr)
        sys.exit(1)
    return name


def require_user(args):
    user = get_arg_or_env(args, "user", "VM_USER")
    if not user:
        print("❌ Error: No VM user specified for SSH.", file=sys.stderr)
        print("  Use -u <user> or set VM_USER environment variable.", file=sys.stderr)
        sys.exit(1)
    return user


def get_vm_ip(vm_name):
    """Return the IP address of a machine, or None."""
    base_cmd = BACKEND.get_virsh_cmd(["domifaddr", vm_name])

    # 1. Ask the guest agent. It is the most reliable source, on every host.
    try:
        out = run(base_cmd + ["--source", "agent"], capture=True, check=False)
        if out:
            for line in out.splitlines():
                if "ipv4" in line.lower():
                    parts = line.split()
                    if len(parts) > 0:
                        # The address carries a /prefix
                        for part in parts:
                            if "/" in part and "." in part:
                                return part.split("/")[0]
    except subprocess.CalledProcessError as e:
        print(f"⚠️  Guest agent query failed: {e}", file=sys.stderr)
    except Exception as e:
        print(f"⚠️  Unexpected error querying guest agent: {e}", file=sys.stderr)

    # 2. Fall back to the DHCP lease. It fails on macOS user networking,
    #    because slirp keeps no bridge lease.
    try:
        out = run(base_cmd + ["--source", "lease"], capture=True, check=False)
        if out:
            for line in out.splitlines():
                if "ipv4" in line.lower():
                    parts = line.split()
                    if len(parts) > 0:
                        for part in parts:
                            if "/" in part and "." in part:
                                return part.split("/")[0]
    except subprocess.CalledProcessError as e:
        print(f"⚠️  Lease query failed: {e}", file=sys.stderr)
    except Exception as e:
        print(f"⚠️  Unexpected error querying leases: {e}", file=sys.stderr)

    return None


# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------


def cmd_list(_args):
    """Print every machine, with its state."""
    run(BACKEND.get_virsh_cmd(["list", "--all"]))


def cmd_start(args):
    name = require_vm_name(args)

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Would start VM: {name}")
        run(BACKEND.get_virsh_cmd(["start", name]), dry_run=True)
        return

    state = run(BACKEND.get_virsh_cmd(["domstate", name]), capture=True)
    if "running" in state:
        print(f"✅ {name} is already running.")
    else:
        run(BACKEND.get_virsh_cmd(["start", name]))
        print(f"🚀 Started {name}.")


def cmd_stop(args):
    name = require_vm_name(args)
    run(BACKEND.get_virsh_cmd(["shutdown", name]), dry_run=args.dry_run)
    if not args.dry_run:
        print(f"🛑 Shutdown signal sent to {name}.")


def cmd_force_stop(args):
    name = require_vm_name(args)
    run(BACKEND.get_virsh_cmd(["destroy", name]), dry_run=args.dry_run)
    if not args.dry_run:
        print(f"💀 Forcefully stopped {name}.")


def cmd_delete(args):
    """Delete the machine, its disk and its NVRAM."""
    name = require_vm_name(args)

    print(f"⚠️  WARNING: This will PERMANENTLY DELETE '{name}' and all its disk images.")

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Skipping confirmation input.")
    else:
        confirm = input(f"Type '{name}' to confirm: ")
        if confirm != name:
            print("❌ Confirmation failed. Aborting.")
            sys.exit(1)

    # Stop it first
    if args.dry_run:
        print(f"🛑 [DRY-RUN] Check state and stop {name} if running.")
    else:
        state = run(BACKEND.get_virsh_cmd(["domstate", name]), capture=True)
        if "running" in state:
            print(f"Stopping {name}...")
            run(BACKEND.get_virsh_cmd(["destroy", name]), check=False)

    print(f"🗑️  Deleting {name}...")

    # Remove the NVRAM file only when it exists
    delete_cmd = ["undefine", name, "--remove-all-storage"]

    if not args.dry_run:
        # Does this machine have NVRAM?
        try:
            nvram_check = run(
                BACKEND.get_virsh_cmd(["dumpxml", name]), capture=True, check=False
            )
            if nvram_check and "nvram" in nvram_check.lower():
                delete_cmd.append("--nvram")
        except:
            pass  # If we can't check, try without --nvram flag
    else:
        delete_cmd.append("--nvram")  # Include in dry-run display

    run(BACKEND.get_virsh_cmd(delete_cmd), dry_run=args.dry_run)

    if not args.dry_run:
        print(f"✅ {name} has been deleted.")


def cmd_create(args):
    """Create a machine with virt-install, using the defaults of this host."""
    name = require_vm_name(args)

    # Refuse when the machine already exists. A dry run skips the check.
    if not args.dry_run:
        if run(BACKEND.get_virsh_cmd(["dominfo", name]), check=False, capture=True):
            print(f"❌ VM '{name}' already exists.", file=sys.stderr)
            sys.exit(1)

    # Defaults
    ram = args.ram or "2048"  # Bumped to 2GB for modern OS comfort
    vcpus = args.cpu or "2"
    disk_size = args.disk or "20"
    variant = args.variant or "debian12"

    print(
        f"🔨 Preparing to create VM '{name}' on {BACKEND.os_type} ({BACKEND.arch})..."
    )
    print(f"   Specs: {ram}MB RAM, {vcpus} CPU, {disk_size}GB Disk")
    print(f"   OS Variant: {variant}")

    # Where the installer comes from
    if args.iso:
        iso_path = os.path.abspath(args.iso)
        if not os.path.isfile(iso_path):
            print(f"❌ ISO file not found: {iso_path}", file=sys.stderr)
            sys.exit(1)
        location_args = ["--cdrom", iso_path]
        print(f"   Source: ISO ({iso_path})")
    else:
        # Debian 12 netinst, for this architecture
        if BACKEND.arch in ("aarch64", "arm64"):
            installer_arch = "arm64"
            print(f"   Source: Debian 12 (Bookworm) Network Install (ARM64)")
        else:
            installer_arch = "amd64"
            print(f"   Source: Debian 12 (Bookworm) Network Install (AMD64)")

        location_args = [
            "--location",
            f"http://deb.debian.org/debian/dists/bookworm/main/installer-{installer_arch}/",
        ]

    # The base virt-install command
    cmd = [
        "virt-install",
        "--name",
        name,
        "--memory",
        ram,
        "--vcpus",
        vcpus,
        "--disk",
        f"size={disk_size}",
        "--os-variant",
        variant,
        "--console",
        "pty,target_type=serial",
    ]

    # Per-host arguments: architecture, graphics, network
    cmd += BACKEND.get_install_args()

    # The install source
    cmd += location_args

    if args.dry_run:
        print("\n🛑 [DRY-RUN] The following command would be executed:")
        print(" ".join(cmd))
        return

    print("\n🚀 Launching installer...")
    try:
        subprocess.run(cmd, check=True)
        print(f"\n✅ VM '{name}' created successfully.")
        print(
            "👉 TIP: Remember to create a user during install that matches your 'vm setup' user."
        )
    except subprocess.CalledProcessError:
        print("\n❌ Creation failed.", file=sys.stderr)
        sys.exit(1)


def cmd_status(args):
    name = require_vm_name(args)
    state = run(BACKEND.get_virsh_cmd(["domstate", name]), capture=True)
    ip = get_vm_ip(name)
    ip_str = ip if ip else "Unknown (Run 'vm setup' to install agent?)"
    print(f"VM:     {name}")
    print(f"State:  {state}")
    print(f"IP:     {ip_str}")
    if BACKEND.os_type == "Darwin" and not ip:
        print(
            "        (Note: On macOS with user networking, IPs are hard to detect without the guest agent.)"
        )


def cmd_ip(args):
    name = require_vm_name(args)
    ip = get_vm_ip(name)
    if ip:
        print(ip)
    else:
        print(f"❌ Could not detect IP for {name}.", file=sys.stderr)
        print(
            f"   Make sure the VM is running and has qemu-guest-agent installed.",
            file=sys.stderr,
        )
        print(
            f"   You can install it with: vm setup -n {name} -u <username>",
            file=sys.stderr,
        )
        sys.exit(1)


def cmd_ssh(args):
    name = require_vm_name(args)
    user = require_user(args)

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Resolving IP for {name}...")
        ip = "1.2.3.4 (PLACEHOLDER)"
    else:
        print(f"🔍 Waiting for {name} to report IP address...", end="", flush=True)
        ip = None
        for _ in range(30): # Wait up to 60 seconds
            ip = get_vm_ip(name)
            if ip:
                print(f" Found: {ip}")
                break
            print(".", end="", flush=True)
            time.sleep(2)

    if not ip:
        print(f"\n❌ Cannot find IP for {name}. Ensure it is running and agent is installed.", file=sys.stderr)
        sys.exit(1)

    # A local machine changes its key often, so ignore the key, and keep it
    # out of known_hosts.
    ssh_cmd = [
        "ssh", 
        "-o", "StrictHostKeyChecking=no", 
        "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR",
        f"{user}@{ip}"
    ] + args.extra

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Would exec: {' '.join(ssh_cmd)}")
        return

    print(f"🔌 Connecting to {user}@{ip}...")
    os.execvp("ssh", ssh_cmd)


def cmd_deploy(args):
    name = require_vm_name(args)
    user = require_user(args)

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Resolving IP...")
        ip = "1.2.3.4"
    else:
        print(f"🔍 Waiting for {name} to report IP address...", end="", flush=True)
        ip = None
        for _ in range(30):
            ip = get_vm_ip(name)
            if ip:
                print(f" Found: {ip}")
                break
            print(".", end="", flush=True)
            time.sleep(2)

    if not ip:
        print(f"\n❌ Cannot find IP for {name}.", file=sys.stderr)
        sys.exit(1)

    script = args.script
    if not os.path.isfile(script):
        print(f"❌ Deployment script not found: {script}", file=sys.stderr)
        sys.exit(1)

    cmd = [os.path.abspath(script), user, ip] + args.extra

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Would run script: {' '.join(cmd)}")
        return

    print(f"📦 Running {script} against {name} ({ip})...")
    
    # The script runs as a separate file, so it does not get the SSH options
    # above. The author of the script must set them.
    subprocess.run(cmd)


def cmd_setup(args):
    name = require_vm_name(args)
    user = require_user(args)

    if args.dry_run:
        print(f"🛑 [DRY-RUN] Would find IP and install guest-agent on {name}")
        return

    print(f"🔍 Waiting for {name} to report IP address...", end="", flush=True)
    ip = None
    for _ in range(30):
        ip = get_vm_ip(name)
        if ip:
            print(f" Found: {ip}")
            break
        print(".", end="", flush=True)
        time.sleep(2)

    if not ip:
        print(f"\n❌ Could not detect IP for {name}.", file=sys.stderr)
        print(f"   The VM must be running and accessible via network.", file=sys.stderr)
        print(
            f"   On macOS, you may need to configure networking or access the VM console first.",
            file=sys.stderr,
        )
        sys.exit(1)

    print(f"🛠️  Installing qemu-guest-agent on {name} ({ip})...")
    print(f"   Detecting package manager...")

    # Build the detect-and-install command
    pkg_managers = BACKEND.get_package_manager_commands()

    # One script that tries each package manager in turn
    install_script_parts = []
    for i, pm in enumerate(pkg_managers):
        detect_cmd = pm["detect"]
        install_cmds = " && ".join(pm["install"])

        if i == 0:
            install_script_parts.append(f"if {detect_cmd}; then")
        else:
            install_script_parts.append(f"elif {detect_cmd}; then")

        install_script_parts.append(f"  echo 'Detected package manager, installing...'")
        install_script_parts.append(f"  {install_cmds}")

    install_script_parts.append("else")
    install_script_parts.append(
        "  echo '❌ Unsupported package manager. Please install qemu-guest-agent manually.'"
    )
    install_script_parts.append("  exit 1")
    install_script_parts.append("fi")
    install_script_parts.append("echo '✅ Agent installed successfully.'")

    remote_cmd = "\n".join(install_script_parts)

    ssh_cmd = [
        "ssh", 
        "-o", "StrictHostKeyChecking=no", 
        "-o", "UserKnownHostsFile=/dev/null",
        "-o", "LogLevel=ERROR",
        f"{user}@{ip}", 
        "-t", 
        f"bash -c '{remote_cmd}'"
    ]

    try:
        subprocess.run(ssh_cmd, check=True)
        print(f"\n✅ Setup complete! The VM should now report its IP address reliably.")
        print(f"   Try: vm status -n {name}")
    except subprocess.CalledProcessError:
        print("\n❌ Setup failed.", file=sys.stderr)
        print(
            "   Make sure you can SSH into the VM and have sudo privileges.",
            file=sys.stderr,
        )
        sys.exit(1)


# ------------------------------------------------------------
# Main
# ------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        prog="vm",
        description="Manage one QEMU virtual machine through virsh and virt-install.",
        epilog=EXAMPLES,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )

    # Global arguments
    parser.add_argument("-n", "--name", help="The machine name. It overrides VM_NAME.")
    parser.add_argument("-u", "--user", help="The SSH user. It overrides VM_USER.")
    parser.add_argument(
        "--dry-run", action="store_true", help="Print every command, and run none"
    )

    subparsers = parser.add_subparsers(dest="command", metavar="<command>")

    # Lifecycle
    subparsers.add_parser("list", help="List every machine, with its state")
    subparsers.add_parser("start", help="Start the machine")
    subparsers.add_parser("stop", help="Shut the machine down cleanly")
    subparsers.add_parser("kill", help="Power the machine off at once")
    subparsers.add_parser("delete", help="Delete the machine, its disk and its NVRAM")
    subparsers.add_parser("status", help="Print the state and the address")
    subparsers.add_parser("ip", help="Print the IP address only")

    # Creation
    create_p = subparsers.add_parser("create", help="Create a machine")
    create_p.add_argument("--ram", help="The RAM in MB. Default 2048.")
    create_p.add_argument("--cpu", help="The number of virtual CPUs. Default 2.")
    create_p.add_argument("--disk", help="The disk size in GB. Default 20.")
    create_p.add_argument(
        "--iso", help="A local ISO file. It replaces the network install."
    )
    create_p.add_argument(
        "--variant", help="The OS variant, such as ubuntu22.04. Default debian12."
    )

    # Tools
    subparsers.add_parser("setup", help="Install qemu-guest-agent inside the machine")
    ssh_p = subparsers.add_parser("ssh", help="Open an SSH session, or run a command")
    ssh_p.add_argument(
        "extra", nargs=argparse.REMAINDER, help="A command to run instead of a session"
    )

    dep_p = subparsers.add_parser("deploy", help="Run a local script against the machine")
    dep_p.add_argument("script", help="The script to run on this host")
    dep_p.add_argument(
        "extra",
        nargs=argparse.REMAINDER,
        help="Arguments after the user and the address",
    )

    args = parser.parse_args()

    if args.command is None:
        if args.name or os.environ.get("VM_NAME"):
            cmd_status(args)
        else:
            parser.print_help()
        sys.exit(0)

    # Dispatch
    cmds = {
        "list": cmd_list,
        "start": cmd_start,
        "stop": cmd_stop,
        "kill": cmd_force_stop,
        "delete": cmd_delete,
        "create": cmd_create,
        "status": cmd_status,
        "ip": cmd_ip,
        "ssh": cmd_ssh,
        "deploy": cmd_deploy,
        "setup": cmd_setup,
    }

    if args.command in cmds:
        cmds[args.command](args)
    else:
        parser.print_help()


if __name__ == "__main__":
    # The help must be readable on a machine with no virsh, so check the tools
    # only when there is real work to do. No arguments and no VM_NAME prints the
    # help as well, so that path skips the checks too.
    _argv = sys.argv[1:]
    _wants_help = (not _argv and not os.environ.get("VM_NAME")) or any(
        a in ("-h", "--help") for a in _argv
    )

    # Check for required tools
    if not _wants_help and not shutil.which("virsh"):
        print("❌ Error: 'virsh' not found.", file=sys.stderr)
        print("   Linux: sudo apt install libvirt-clients", file=sys.stderr)
        print("   macOS: brew install libvirt virt-manager", file=sys.stderr)
        sys.exit(1)

    # Only `create` needs virt-install
    if not _wants_help and "create" in _argv:
        if not shutil.which("virt-install"):
            print("❌ Error: 'virt-install' not found.", file=sys.stderr)
            print("   Linux: sudo apt install virtinst", file=sys.stderr)
            print("   macOS: brew install virt-manager", file=sys.stderr)
            sys.exit(1)

    # Warn when the daemon does not answer, then continue anyway
    if not _wants_help and not check_libvirt_running():
        print("⚠️  Warning: Cannot connect to libvirt daemon.", file=sys.stderr)
        print("   Linux: sudo systemctl start libvirtd", file=sys.stderr)
        print("   macOS: brew services start libvirt", file=sys.stderr)
        print("   Continuing anyway...\n", file=sys.stderr)

    main()

