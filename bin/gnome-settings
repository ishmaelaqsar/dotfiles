#!/usr/bin/env python3
"""
gnome-settings — apply, dump, or restore the GNOME desktop settings this repo
manages. gsettings is GNOME's counterpart to `defaults write` on macOS.

Only the keys in SETTINGS are touched. A full `dconf dump /` is not tracked on
purpose: it is machine-specific and unreadable in a diff.

Before a key changes, the script writes its previous value to
~/.local/state/dotfiles/gnome-settings.json. `restore` and cleanup.sh read that
file to put the desktop back.
"""

USAGE = """Usage: gnome-settings <command>

  apply      Set every managed key. install.sh runs this when it detects GNOME.
  dump       Print the current value of every managed key. Changes nothing.
  restore    Put the previous values back, and delete the state file.
             cleanup.sh runs this.
  -h, --help Print this text.

The script exits 0 and does nothing when gsettings is absent, so it is safe to
call on a machine that does not run GNOME.

Exit codes: 0 success or not a GNOME machine, 2 the command is not valid.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

STATE_FILE = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    / "dotfiles"
    / "gnome-settings.json"
)

MEDIA_KEYS = "org.gnome.settings-daemon.plugins.media-keys"
WM_KEYS = "org.gnome.desktop.wm.keybindings"
SHELL_KEYS = "org.gnome.shell.keybindings"
MUTTER_KEYS = "org.gnome.mutter.keybindings"

# App launchers: (slug, name, command, binding). Each one becomes a custom
# keybinding under the relocatable schema below, at a path this repository owns.
# dotfiles/.config/hypr/hyprland.conf follows the same Super layout, with a
# few divergent chords — the README's keybinding table is the reference.
# The trailing slash is part of a gsettings path.
LAUNCHERS = [
    # Super+Return is the i3/sway/Hyprland idiom for "terminal", and GNOME
    # leaves the key free.
    ("terminal", "Ghostty", "ghostty", "<Super>Return"),
    # A new frame on the running daemon, and start the daemon when none runs.
    ("emacs", "Emacs", "emacsclient -c --alternate-editor=", "<Super>e"),
]

KB_BASE = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/dotfiles-"
KB_SCHEMA = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"


def kb_path(slug):
    return f"{KB_BASE}{slug}/"


def kb_schema(slug):
    return f"{KB_SCHEMA}:{kb_path(slug)}"


# How many static workspaces to keep, and therefore how many Super+N jumps.
WORKSPACES = 4

# (schema, key, value). Values are GVariant text, exactly as `gsettings set`
# takes them — so a string carries its own quotes.
SETTINGS = [
    # GTK4 and libadwaita apps read the key theme here, not from
    # ~/.config/gtk-3.0/settings.ini. Both are needed to cover GTK2/3 and GTK4.
    ("org.gnome.desktop.interface", "gtk-key-theme", "'Emacs'"),
    ("org.gnome.desktop.interface", "color-scheme", "'prefer-dark'"),
    ("org.gnome.desktop.interface", "monospace-font-name", "'0xProto Nerd Font Mono 12'"),
    # Caps Lock as a second Control.
    ("org.gnome.desktop.input-sources", "xkb-options", "['ctrl:nocaps']"),
    ("org.gnome.desktop.peripherals.keyboard", "delay", "250"),
    ("org.gnome.desktop.peripherals.keyboard", "repeat-interval", "25"),
    ("org.gnome.settings-daemon.plugins.color", "night-light-enabled", "true"),
    # Fractional scaling on Wayland.
    ("org.gnome.mutter", "experimental-features", "['scale-monitor-framebuffer']"),
    # Nautilus "Open in Terminal", and anything else that asks the desktop for
    # a terminal.
    ("org.gnome.desktop.default-applications.terminal", "exec", "'ghostty'"),
    ("org.gnome.desktop.default-applications.terminal", "exec-arg", "'-e'"),
    # The browser and the file manager go through GNOME's own media keys, so
    # they follow the default apps instead of a hard-coded command.
    (MEDIA_KEYS, "www", "['<Super>b']"),
    (MEDIA_KEYS, "home", "['<Super>n']"),
    # Super+Space opens the app grid, the launcher. GNOME ships Super+Space as
    # the input-source switch, which has to go first, or the shell keeps the key.
    (WM_KEYS, "switch-input-source", "[]"),
    (WM_KEYS, "switch-input-source-backward", "[]"),
    # Super+` belongs to the drop-down terminal (the quake-terminal
    # extension). GNOME ships it as switch-group, which grabs the key ahead
    # of the extension, the same way switch-input-source shadowed Super+Space.
    (WM_KEYS, "switch-group", "[]"),
    (WM_KEYS, "switch-group-backward", "[]"),
    (SHELL_KEYS, "toggle-application-view", "['<Super>space', '<Super>a']"),
    (SHELL_KEYS, "show-screenshot-ui", "['<Super><Shift>s', 'Print']"),
    # Super+l is the lock key by default, and tiling right wants it.
    (MEDIA_KEYS, "screensaver", "['<Super>Escape']"),
    # Window keys. Super+q closes, Super+f goes full screen, Super+m toggles
    # the maximised state. Super+h and Super+l tile left and right; Super+k and
    # Super+j maximise and unmaximise. Super+h minimises by default, and a
    # keyboard desktop has no use for a window it cannot see, so that goes.
    (WM_KEYS, "close", "['<Super>q', '<Alt>F4']"),
    (WM_KEYS, "minimize", "[]"),
    (WM_KEYS, "toggle-fullscreen", "['<Super>f']"),
    (WM_KEYS, "toggle-maximized", "['<Super>m', '<Alt>F10']"),
    (WM_KEYS, "maximize", "['<Super>k', '<Super>Up']"),
    (WM_KEYS, "unmaximize", "['<Super>j', '<Super>Down']"),
    (MUTTER_KEYS, "toggle-tiled-left", "['<Super>h', '<Super>Left']"),
    (MUTTER_KEYS, "toggle-tiled-right", "['<Super>l', '<Super>Right']"),
    # Numbered workspaces need a fixed count. GNOME's dynamic workspaces grow
    # and shrink, so "jump to 4" has nothing to jump to on a quiet desktop.
    ("org.gnome.mutter", "dynamic-workspaces", "false"),
    ("org.gnome.desktop.wm.preferences", "num-workspaces", str(WORKSPACES)),
]

for slug, name, command, binding in LAUNCHERS:
    SETTINGS += [
        (kb_schema(slug), "name", f"'{name}'"),
        (kb_schema(slug), "command", f"'{command}'"),
        (kb_schema(slug), "binding", f"'{binding}'"),
    ]

# Super+N jumps to a workspace and Super+Shift+N moves the window there — the
# i3 layout. GNOME ships Super+N as "switch to application N" in the dash, so
# that binding has to go first, or the shell grabs the key before Mutter.
# Left/right switching is already Super+Alt+Left/Right and Super+PageUp/Down.
for n in range(1, WORKSPACES + 1):
    SETTINGS += [
        (SHELL_KEYS, f"switch-to-application-{n}", "[]"),
        (WM_KEYS, f"switch-to-workspace-{n}", f"['<Super>{n}']"),
        (WM_KEYS, f"move-to-workspace-{n}", f"['<Super><Shift>{n}']"),
    ]


def gsettings(*args):
    """Run gsettings. Returns (ok, stripped stdout)."""
    result = subprocess.run(
        ["gsettings", *args], capture_output=True, text=True, check=False
    )
    return result.returncode == 0, result.stdout.strip()


def get(schema, key):
    """Current value, or None when the schema is not installed."""
    ok, value = gsettings("get", schema, key)
    return value if ok else None


def default_of(schema, key):
    """The schema default, read by resetting the key and reading it back."""
    gsettings("reset", schema, key)
    return get(schema, key)


def parse_list(variant):
    """Parse a GVariant string array: "['a', 'b']" -> ['a', 'b']."""
    inner = variant.strip()
    if inner.startswith("@as"):
        inner = inner[3:].strip()
    inner = inner.strip("[]").strip()
    if not inner:
        return []
    return [item.strip().strip("'") for item in inner.split(",")]


def format_list(items):
    return "[" + ", ".join(f"'{item}'" for item in items) + "]"


def load_state():
    if STATE_FILE.exists():
        return json.loads(STATE_FILE.read_text())
    return {}


def save_state(state):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2) + "\n")


def apply():
    state = load_state()

    def remember(schema, key, current):
        # setdefault, so a re-run never records the value set here over the
        # pre-dotfiles one, and a key added later still gets recorded.
        state.setdefault(f"{schema} {key}", current)

    for schema, key, value in SETTINGS:
        current = get(schema, key)
        if current is None:
            print(f"  skip {schema} {key} (schema not installed)")
            continue
        remember(schema, key, current)
        if current == value:
            continue
        ok, _ = gsettings("set", schema, key, value)
        print(f"  {'set ' if ok else 'FAIL'} {schema} {key} = {value}")

    # Register the keybinding paths. GNOME reads a custom binding only when its
    # path is listed here.
    bindings = get(MEDIA_KEYS, "custom-keybindings")
    if bindings is not None:
        remember(MEDIA_KEYS, "custom-keybindings", bindings)
        merged = parse_list(bindings)
        missing = [kb_path(slug) for slug, *_ in LAUNCHERS if kb_path(slug) not in merged]
        if missing:
            gsettings("set", MEDIA_KEYS, "custom-keybindings", format_list(merged + missing))
            for path in missing:
                print(f"  set  {MEDIA_KEYS} custom-keybindings += {path}")

    save_state(state)
    print(f"Applied. Previous values saved in {STATE_FILE}")


def dump():
    for schema, key, _ in SETTINGS:
        print(f"{schema} {key} = {get(schema, key)}")
    print(f"{MEDIA_KEYS} custom-keybindings = {get(MEDIA_KEYS, 'custom-keybindings')}")


def restore():
    state = load_state()
    if not state:
        print("Nothing to restore — no saved state.")
        return

    for name, old in state.items():
        schema, key = name.rsplit(" ", 1)
        # Reset first, so a key the desktop never set stays unset instead of
        # becoming an explicit user value that only equals the default.
        current = default_of(schema, key)
        if current is None:
            print(f"  skip {schema} {key} (schema not installed)")
            continue
        if current != old:
            gsettings("set", schema, key, old)
        print(f"  restored {schema} {key} = {old}")

    STATE_FILE.unlink()
    print("Restored.")


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        print()
        print(USAGE, end="")
        return 0
    if len(argv) != 1 or argv[0] not in ("apply", "dump", "restore"):
        print(f"Unknown command: {' '.join(argv)}\n", file=sys.stderr)
        print(USAGE, end="", file=sys.stderr)
        return 2
    if shutil.which("gsettings") is None:
        print("gsettings not found — not a GNOME machine. Nothing to do.")
        return 0
    {"apply": apply, "dump": dump, "restore": restore}[sys.argv[1]]()
    return 0


if __name__ == "__main__":
    sys.exit(main())
