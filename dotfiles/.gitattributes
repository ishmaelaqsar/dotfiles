############################################################
# Default behaviour
############################################################
# LF in the repository, native line endings on checkout.
* text=auto eol=lf

############################################################
# Line endings
############################################################
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

*.py text eol=lf

*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

############################################################
# Diff drivers
############################################################
*.c text diff=c
*.cpp text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp

*.java text diff=java

*.html text
*.css text
*.js text
*.ts text
*.tsx text
*.jsx text

*.md text diff=markdown
*.rst text
*.txt text

*.sql text diff=sql

############################################################
# Binary files
############################################################
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.class binary
*.jar binary

############################################################
# Merge and diff
############################################################
# A lock file merges line by line, because the lines are independent.
*.lock merge=union
package-lock.json merge=union
poetry.lock merge=union
yarn.lock merge=union

*.png -diff
*.jpg -diff
*.jpeg -diff
*.pdf -diff

############################################################
# Linguist overrides
############################################################
*.min.js linguist-vendored
node_modules/* linguist-vendored
dist/* linguist-vendored
build/* linguist-vendored
vendor/* linguist-vendored

############################################################
# Editor metadata and build files
############################################################
*.iml text eol=lf
.idea/* text eol=lf
.vscode/* text eol=lf

Makefile text eol=lf
Dockerfile text eol=lf
