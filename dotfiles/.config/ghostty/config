theme = Zenburn
font-family = "0xProto Nerd Font Mono"
font-size = 12
background-opacity = 1.0
background-blur = 0

window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = native

cursor-style = block
cursor-style-blink = false

# `clipboard` = copy selections to the system clipboard too, not just the
# primary selection (`true` never reaches ctrl+shift+v on Linux)
copy-on-select = clipboard

# Meta + Shift + O to open the current directory in VS Code
keybind = alt+shift+o=text:code .\r

# Machine-local overrides (untracked); opt in to the quick terminal here
# with `config-file = quick-terminal.conf` (automatic on macOS via install.sh)
config-file = ?config.local
