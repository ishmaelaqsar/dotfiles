theme = IBM 5153 CGA (Black)
font-family = "0xProto Nerd Font Mono"
font-size = 12
background-opacity = 1.0
background-blur = 0

window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = native

cursor-style = block
cursor-style-blink = false

# Option is Alt, whatever the keyboard layout. Ghostty leaves this to the
# layout by default, and a non-US layout (British is enabled here) then sends
# Unicode instead: M-f, M-s, M-x and M-h/j/k/l in tmux, and M-j in Emacs, all
# stop working. Unicode input through Option goes with it.
macos-option-as-alt = true

# `clipboard` copies a selection to the system clipboard as well as to the
# primary selection. With `true`, ctrl+shift+v on Linux gets nothing.
copy-on-select = clipboard

# Meta+Shift+o opens the current directory in an Emacs frame, in Dired.
keybind = alt+shift+o=text:emacsclient -c --alternate-editor= .\r

# Machine-local overrides. The repo does not track config.local. Add
# `config-file = quick-terminal.conf` to it for the quick terminal. install.sh
# does this on macOS.
config-file = ?config.local
