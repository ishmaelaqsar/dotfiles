# EditorConfig: one indent and line-ending rule per file type.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88
end_of_line = lf

[*.java]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{js,ts,jsx,tsx}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{json,yml,yaml,toml,ini,cfg}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{md,rst,txt}]
trim_trailing_whitespace = false
end_of_line = lf
indent_style = space
indent_size = 2

# make reads a recipe line only when a tab starts it.
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.{xml,html,css}]
indent_style = space
indent_size = 2
end_of_line = lf

[Dockerfile]
indent_style = space
indent_size = 2
end_of_line = lf

