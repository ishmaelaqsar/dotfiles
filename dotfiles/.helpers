# Usage: encrypt <file_or_folder> [recipient_email]
#        echo "string" | encrypt [recipient_email]
#
# Encrypt a file, a directory (as a .tar.gz archive), or stdin. The recipient
# defaults to $IDENTITY. The output is <filename>.<timestamp>.enc.
encrypt() {
    local recipient
    local output

    # Data on stdin, as in `echo hi | encrypt`. `! -t 0` is true in every
    # script and every agent shell, so also require that no argument names a
    # file. Otherwise `encrypt notes.txt` in a script reads the file name as the
    # recipient.
    if [[ ! -t 0 && ( -z "$1" || ! -e "$1" ) ]]; then
        recipient="${1:-$IDENTITY}"
        output="encrypted.$(date +%s).enc"

        if [[ -z "$recipient" ]]; then
            echo "Error: No recipient specified via argument or environment variables."
            return 1
        fi

        gpg --encrypt --armor --output "$output" -r "$recipient" && \
        echo "Encrypted message from stdin -> $output"
        return 0
    fi

    local input="${1%/}"

    if [[ -z "$input" ]]; then
        echo "Usage: encrypt <filename/folder> [recipient]"
        echo "   or: echo 'message' | encrypt [recipient]"
        return 1
    fi

    recipient="${2:-$IDENTITY}"
    if [[ -z "$recipient" ]]; then
        echo "Error: No recipient specified. Pass as 2nd arg or set \$IDENTITY."
        return 1
    fi

    local file_to_encrypt="$input"
    local is_temp_file=false

    if [[ -d "$input" ]]; then
        echo "Directory detected. Archiving '$input'..."
        file_to_encrypt="${input}.tar.gz"
        tar -czf "$file_to_encrypt" "$input" || return 1
        is_temp_file=true
    elif [[ ! -f "$input" ]]; then
        echo "Error: File or Directory '$input' not found."
        return 1
    fi

    output="${file_to_encrypt}.$(date +%s).enc"

    gpg --encrypt --armor --output "$output" -r "$recipient" "$file_to_encrypt"
    local status=$?

    if [[ $status -eq 0 ]]; then
        echo "Encrypted for $recipient: $output"
        if $is_temp_file; then
            rm "$file_to_encrypt"
        fi
    else
        echo "Encryption failed."
    fi
}

# Usage: decrypt <filename.enc>
#
# Decrypt the file and restore the original name without .timestamp.enc.
# Extract an archive (tar, tgz), and remove the archive file.
decrypt() {
    local input="$1"

    if [[ -z "$input" ]]; then
        echo "Usage: decrypt <filename.enc>"
        return 1
    fi

    local output="${input%.*.*}"

    if [[ "$input" == "$output" ]]; then
         echo "Warning: Filename format unexpected. Removing only last extension."
         output="${input%.*}"
    fi

    gpg --decrypt --output "$output" "$input" || return 1
    echo "Decrypted: $output"

    if [[ "$output" == *.tar.gz || "$output" == *.tgz || "$output" == *.tar ]]; then
        echo "Archive detected. Extracting..."
        tar -xf "$output" && rm "$output"
        echo "Extracted content from $output"
    fi
}

# Usage: sign <filename>
#
# Create a detached, ASCII-armoured signature at <filename>.asc. The input file
# is unchanged.
sign() {
    local input="$1"
    local signer="$IDENTITY"

    if [[ -z "$input" ]]; then
        echo "Usage: sign <filename>"
        return 1
    fi

    if [[ ! -f "$input" ]]; then
        echo "Error: File '$input' not found."
        return 1
    fi

    if [[ -z "$signer" ]]; then
        echo "Error: \$IDENTITY is not set."
        return 1
    fi

    local output="${input}.asc"

    gpg --detach-sign --armor --local-user "$signer" --output "$output" "$input" && \
    echo "Detached signature created: $output"
}

# Usage: verify <filename> <signature_file>
#
# Verify the detached signature of a file.
verify() {
    local input="$1"
    local sig_file="$2"

    if [[ -z "$input" ]] || [[ -z "$sig_file" ]]; then
        echo "Usage: verify <filename> <signature_file>"
        return 1
    fi

    if [[ ! -f "$input" ]]; then
        echo "Error: Data file '$input' not found."
        return 1
    fi

    if [[ ! -f "$sig_file" ]]; then
        echo "Error: Signature file '$sig_file' not found."
        return 1
    fi

    # gpg takes the signature first, then the data.
    gpg --verify "$sig_file" "$input"
}

# Usage: __are_secrets_loaded
#
# Return 0 when every key in .secrets is in the environment, or only the named
# keys when arguments are given.
__are_secrets_loaded() {
    local secrets_file="$HOME/.secrets"
    if [[ ! -f "$secrets_file" ]]; then
        return 0
    fi

    if [[ $# -gt 0 ]]; then
        local key
        for key in "$@"; do
            if [[ -z "${!key}" ]]; then
                return 1
            fi
        done
        return 0
    fi

    # Check all keys in the file. The `|| [[ -n ... ]]` reads a last line that
    # carries no newline.
    local line key
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" =~ ^([A-Za-z0-9_]+)= ]]; then
            key="${BASH_REMATCH[1]}"
            if [[ -z "${!key}" ]]; then
                return 1
            fi
        fi
    done < "$secrets_file"

    return 0
}

# Usage: add_secret API_KEY
#        add_secret API_KEY "super_secret_value"
#
# Encrypt the value into .secrets, and export it to the current shell.
# Without the value the shell asks for it, and reads it without an echo. Prefer
# that form: a value on the command line lands in ~/.bash_history, and `ps`
# shows it while the command runs.
add_secret() {
    local key="$1" value="$2"

    if [ -z "$key" ]; then
        echo "Usage: add_secret <KEY> [VALUE]" >&2
        echo "Leave out VALUE, and the shell asks for it." >&2
        return 1
    fi

    if [ -z "$value" ]; then
        read -rsp "Value for $key: " value
        echo
        if [ -z "$value" ]; then
            echo "Nothing entered." >&2
            return 1
        fi
    fi

    # The value goes in on stdin, so it stays out of the argument list. eval
    # applies the `export` line the tool prints. Capture it first and test the
    # status: manage-secrets exits 1 with an empty stdout when GPG fails, and
    # `eval ""` succeeds, which would report a secret it never stored.
    local export_line
    export_line="$(printf '%s' "$value" | manage-secrets encrypt "$key")" || {
        echo "add_secret: $key was not stored." >&2
        return 1
    }
    eval "$export_line"
}

# Usage: load_secrets [KEY...]
# Ask the YubiKey for the PIN, then export every secret, or only the named
# ones.
load_secrets() {
    echo "Loading secrets from YubiKey..."
    # Capture before the eval, for the reason add_secret gives.
    local export_lines
    export_lines="$(manage-secrets decrypt "$@")" || {
        echo "load_secrets: nothing was exported." >&2
        return 1
    }
    eval "$export_lines"
}

# ============================================================
# Kubernetes
# ============================================================
# Defined only where kubectl is. Without it the functions could never run,
# and their names would shadow nothing useful.
if command -v kubectl >/dev/null 2>&1; then
    kube-debug() {
        local namespace="${KUBE_NS:-default}"
        local pod=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -n|--namespace)
                    namespace="$2"
                    shift 2
                    ;;
                *)
                    pod="$1"
                    shift
                    ;;
            esac
        done

        if [[ -z "$pod" ]]; then
            echo "Error: Pod name is required."
            echo "Usage: kube-debug [-n namespace] <pod_name>"
            return 1
        fi

        echo "Attaching debug container to '$pod' in namespace '$namespace'..."
        kubectl debug -it -n "$namespace" "$pod" --image=alpine
    }

    kube-dump() {
        local namespace="${KUBE_NS:-default}"
        local pod=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -n|--namespace) namespace="$2"; shift 2 ;;
                *) pod="$1"; shift ;;
            esac
        done

        if [[ -z "$pod" ]]; then
            echo "Usage: kube-dump [-n namespace] <pod_name>"
            return 1
        fi

        local filename="${pod}_$(date +%s).log"
        echo "Dumping ALL logs for '$pod' in '$namespace' to $filename..."

        kubectl logs -n "$namespace" "$pod" --all-containers --timestamps --tail=-1 > "$filename"

        echo "Wrote $filename."
    }

    kube-crash() {
        local namespace="${KUBE_NS:-default}"
        local pod=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -n|--namespace) namespace="$2"; shift 2 ;;
                *) pod="$1"; shift ;;
            esac
        done

        if [[ -z "$pod" ]]; then
            echo "Usage: kube-crash [-n namespace] <pod_name>"
            return 1
        fi

        echo "Fetching previous (crashed) logs for '$pod' in '$namespace'..."
        kubectl logs -n "$namespace" "$pod" -p --all-containers | less
    }

    # rg when it is there, grep otherwise.
    if command -v rg >/dev/null 2>&1; then
        alias kfind='kubectl get pods -A | rg -i'
    else
        alias kfind='kubectl get pods -A | grep -i'
    fi
fi

# ============================================================
# Second brain (Obsidian vault)
# ============================================================
: "${OBSIDIAN_VAULT:=$HOME/vault}"
export OBSIDIAN_VAULT

# jot: append a raw bullet to today's daily note — no LLM, instant.
# For agent-formatted capture use /daily inside sb.
# Usage: jot remember to fix the fence   |   jot "#idea try X"
jot() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: jot <text>" >&2
        return 1
    fi
    local dir="$OBSIDIAN_VAULT/Daily Notes"
    local file="$dir/$(date +%F).md"
    mkdir -p "$dir"
    printf '* %s %s\n' "$(date +%H:%M)" "$*" >> "$file"
    echo "jotted → Daily Notes/$(date +%F).md"
}

# dotfiles: with no argument, enter the repository. A script cannot change the
# directory of its caller, so that one case has to live here. Every other
# argument goes to bin/dotfiles, which an agent or a script can call directly.
# `command` skips this function and finds the script on PATH.
dotfiles() {
    if [ "$#" -eq 0 ]; then
        cd "$(command dotfiles path)" || return 1
    else
        command dotfiles "$@"
    fi
}

# sb: enter the vault and launch the terminal agent over it as a second brain.
# Forwards any arguments to opencode (for example `sb /brief`).
sb() {
    cd "$OBSIDIAN_VAULT" || return 1
    if command -v opencode >/dev/null 2>&1; then
        opencode "$@"
    else
        echo "opencode is not installed — vault is at $OBSIDIAN_VAULT (https://opencode.ai)"
    fi
}
