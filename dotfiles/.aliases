# Let an alias follow sudo (for example `sudo ll`)
alias sudo='sudo '

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias -- -='cd -'  # Go back to previous directory

# Modern replacements, guarded so a fresh machine keeps stock ls/grep.
# Debian installs fd as `fdfind`, hence the elif. The functions below call __fd,
# so one name covers both platforms. Do not alias `find` itself: scripts that
# the shell sources (for example sdkman-init.sh) call `find -type f`, and fd
# rejects those flags.
command -v rg >/dev/null && alias grep='rg --smart-case'
if command -v fd >/dev/null; then
    __fd() { fd "$@"; }
elif command -v fdfind >/dev/null; then
    __fd() { fdfind "$@"; }
else
    __fd() { echo "fd is not installed." >&2; return 1; }
fi
command -v lazydocker >/dev/null && alias lzd='lazydocker'
if command -v eza >/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias l='eza --icons --group-directories-first'
    alias ll='eza --icons --group-directories-first -l'
    alias la='eza --icons --group-directories-first -a'
    alias lla='eza --icons --group-directories-first -la'
    alias llt='eza --icons --group-directories-first -lars modified'
fi

# Wayland clipboard under the macOS names, so the muscle memory carries over.
if ! command -v pbcopy >/dev/null && command -v wl-copy >/dev/null; then
    alias pbcopy='wl-copy'
    alias pbpaste='wl-paste --no-newline'
fi

# Arch upkeep (pacman-contrib). An upgrade leaves .pacnew files behind and
# never says so, and the package cache grows without limit.
command -v checkupdates >/dev/null && alias pacup='checkupdates'
# pacdiff runs under sudo, where ~/bin is not on PATH, so the path is absolute.
command -v pacdiff >/dev/null && alias pacnew="sudo DIFFPROG=$HOME/bin/ediff pacdiff"
command -v paccache >/dev/null && alias paccleanup='sudo paccache -rk2'
command -v pacman >/dev/null && alias pacorphans='pacman -Qtdq'

# Quickly reload bash configuration
alias reload='source ~/.bashrc && echo "Bash config reloaded."'

# Restart GPG agent to fix YubiKey issues
alias fixgpg="gpgconf --kill gpg-agent && gpg-connect-agent /bye && gpg --card-status"

# Show my public IP (useful for whitelisting)
alias myip='curl ifconfig.me'

# The fzf preview for a directory. eza draws a tree; ls is the fallback. The
# preview runs through sh, so the ls alias above does not apply to it.
if command -v eza >/dev/null; then
    __FZF_DIR_PREVIEW='eza --icons --group-directories-first --tree --level=2 --color=always {}'
else
    __FZF_DIR_PREVIEW='ls -A {}'
fi

# Usage: ce some-project-name
# Fuzzy find a directory under $WORKSPACE, and open it in an Emacs frame (Dired).
# --alternate-editor= with an empty value starts a daemon when none runs, and
# needs no quoting inside the function, unlike -a ''.
ce() {
    local dir
    dir=$(__fd --type d --max-depth 3 . "$WORKSPACE" \
        | fzf --height 40% --reverse --query="$1" --select-1 --exit-0 \
              --preview "$__FZF_DIR_PREVIEW" --preview-window "right,50%")
    if [ -n "$dir" ]; then
        emacsclient -c --alternate-editor= "$dir"
    fi
}

# Fuzzy find and cd into a directory within $WORKSPACE
pj() {
    local dir
    dir=$(__fd --type d --max-depth 3 . "$WORKSPACE" \
        | fzf --height 40% --reverse --prompt="Workspace > " \
              --preview "$__FZF_DIR_PREVIEW" --preview-window "right,50%")
    if [[ -n "$dir" ]]; then
        cd "$dir" || return
    fi
}

# tmux sessions.
#
# `new-session -A` attaches to the named session, or creates it when it is not
# there, so one verb covers both. That form refuses to run inside tmux, where
# attaching a client to its own server nests it, so __tmux_goto switches the
# current client instead.
__tmux_goto() {
    local name="$1"
    if [[ -n "$TMUX" ]]; then
        tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name"
        tmux switch-client -t "=$name"
    else
        tmux new-session -A -s "$name"
    fi
}

# List the sessions on the server
alias tl="tmux list-sessions"

# Go to a session. With no name, pick one from the running sessions.
ta() {
    local name="$1"
    if [[ -z "$name" ]]; then
        name=$(tmux list-sessions -F '#{session_name}' 2>/dev/null \
            | fzf --height 40% --reverse --prompt="session > ") || return
    fi
    [[ -n "$name" ]] && __tmux_goto "$name"
}

# Go to the session named main, and create it on the first call
tm() { __tmux_goto main; }

# Go to a session by name, and create it on the first call (Usage: tn <name>)
tn() { __tmux_goto "${1:?usage: tn <session_name>}"; }

# Kill every session, and the server with them
alias tkill="tmux kill-server"
